# Copy this file to .env and fill in the values before running locally:
#   cp supabase/functions/.env.example supabase/functions/.env
#
# Then serve the function with:
#   supabase functions serve mcp-server --env-file supabase/functions/.env
#
# Never commit .env — it is listed in .gitignore.

# -----------------------------------------------------------------------------
# MCP_DB_URL (required) — the only value you must set.
# -----------------------------------------------------------------------------
# Connection string for the dedicated `mcp_sql_executor` Postgres login created
# by the migration. This is the only credential the agent SQL runtime uses, and
# it has no fallback: a missing value fails closed rather than silently
# connecting as a privileged role.
#
# LOCAL: the line below works as-is. `supabase db reset` runs supabase/seed.sql,
# which sets the matching password on the role, so there is no manual step.
#
# Host is `db:5432`, NOT 127.0.0.1:54322. `supabase functions serve` runs the
# function inside the edge-runtime container, where 127.0.0.1 is the container
# itself; `db` is the Postgres container's network alias (the same value
# Supabase injects as SUPABASE_DB_URL). Host-side tools like psql still use
# 127.0.0.1:54322.
MCP_DB_URL=postgresql://mcp_sql_executor:local-dev-password@db:5432/postgres

# Optional MCP identity. Use a short, project-specific name because MCP clients
# often show it directly in their tool lists.
MCP_SERVER_NAME=tasks
MCP_SERVER_DESCRIPTION="MCP access to the tasks database for the signed-in user."

# Auth mode. When "false", only audience-bound OAuth tokens are accepted and
# first-party Supabase user JWTs (e.g. an in-project agent forwarding the user's
# session token) are rejected. Defaults to "true".
MCP_ALLOW_FIRST_PARTY_JWT=true

# HOSTED: set the role password once, then store secrets (never commit passwords):
#
#   supabase db query --linked "alter role mcp_sql_executor with password '<PASSWORD>';"
#
#   Copy the Transaction pooler host from Dashboard → Database → Connection
#   string (e.g. aws-0-ap-southeast-2.pooler.supabase.com — not <region>.pooler).
#   Username must be mcp_sql_executor.<PROJECT_REF>.
#
#   supabase secrets set \
#     MCP_DB_URL="postgresql://mcp_sql_executor.<PROJECT_REF>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres" \
#     MCP_RESOURCE_URL="https://<project-ref>.supabase.co/functions/v1/mcp-server" \
#     MCP_AUTH_ISSUER="https://<project-ref>.supabase.co/auth/v1" \
#     MCP_SERVER_NAME="tasks" \
#     MCP_SERVER_DESCRIPTION="MCP access to the tasks database for the signed-in user."

# Optional agent SQL limits (MCP_SQL_MAX_ROWS, MCP_SQL_STATEMENT_TIMEOUT_MS,
# etc.) have safe code defaults. Override them only if needed — see the
# README "Runtime configuration" table for names and defaults.
